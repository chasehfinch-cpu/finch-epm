name: Financial Reports
description: Comprehensive multi-view financial analysis — P&L, trends, bridge, site performance
sources:
  - netsuite/ecp
  - sqlserver/financedw
  - sqlserver/azure

theme: financial

brand:
  company_name: Financial Reports
  footer_text: Generated by finch-epm

filters:
  - name: year
    label: Year
    query: >
      SELECT DISTINCT SPLIT_PART(tx.trandate, '/', 3) AS year
      FROM ns__Transaction tx
      WHERE CAST(SPLIT_PART(tx.trandate, '/', 3) AS INTEGER) >= 2022
      ORDER BY year DESC
    parameter: selected_year
    default: "2025"

  - name: entity
    label: Entity
    query: >
      SELECT DISTINCT name AS entity
      FROM Subsidiary
      WHERE isinactive = 'F' AND name NOT LIKE '%limination%'
      ORDER BY name
    parameter: selected_entity

queries:
  # ── KPI totals ──
  - name: kpis
    sql: |
      SELECT
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END)
        - SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS ebitda,
        ROUND(SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END)
        / NULLIF(SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END), 0) * 100, 1) AS expense_ratio
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)

  # ── Monthly trend ──
  - name: monthly_trend
    sql: |
      SELECT
        SPLIT_PART(tx.trandate, '/', 3) || '-' || LPAD(SPLIT_PART(tx.trandate, '/', 1), 2, '0') AS month,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)
      GROUP BY month
      ORDER BY month

  # ── Revenue by entity ──
  - name: rev_by_entity
    sql: |
      SELECT
        COALESCE(sub.name, '(Unmapped)') AS entity,
        SUM(CAST(t.amount AS DOUBLE)) * -1 AS revenue
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T' AND a.accttype IN ('Income','OthIncome')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)
      GROUP BY entity
      HAVING SUM(CAST(t.amount AS DOUBLE)) * -1 > 0
      ORDER BY revenue DESC

  # ── Expense by account type ──
  - name: expense_by_type
    sql: |
      SELECT
        a.accttype AS expense_type,
        SUM(CAST(t.amount AS DOUBLE)) AS expense
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T' AND a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)
      GROUP BY expense_type
      ORDER BY expense DESC

  # ── EBITDA bridge ──
  - name: ebitda_bridge
    sql: |
      SELECT
        CASE
          WHEN a.accttype IN ('Income','OthIncome') THEN 'Revenue'
          WHEN a.accttype = 'COGS' THEN 'COGS'
          WHEN a.accttype IN ('Expense','OthExpense') THEN 'Operating Expense'
          WHEN a.accttype = 'DeferExpense' THEN 'D&A'
          ELSE 'Other'
        END AS category,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1
            ELSE CAST(t.amount AS DOUBLE) * -1 END) AS amount
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome','Expense','OthExpense','COGS','DeferExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)
      GROUP BY category
      ORDER BY CASE category WHEN 'Revenue' THEN 1 WHEN 'COGS' THEN 2
        WHEN 'Operating Expense' THEN 3 WHEN 'D&A' THEN 4 ELSE 5 END

  # ── P&L summary ──
  - name: pl_summary
    sql: |
      SELECT
        CASE
          WHEN a.accttype IN ('Income','OthIncome') THEN 'Revenue'
          WHEN a.accttype = 'COGS' THEN 'Cost of Goods Sold'
          WHEN a.accttype IN ('Expense','OthExpense') THEN 'Operating Expenses'
          WHEN a.accttype = 'DeferExpense' THEN 'Depreciation & Amortization'
          ELSE a.accttype
        END AS category,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1
            ELSE CAST(t.amount AS DOUBLE) END) AS amount
      FROM ns__TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN ns__Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      LEFT JOIN Subsidiary sub ON CAST(tx.entity AS INTEGER) = CAST(sub.id AS INTEGER)
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome','Expense','OthExpense','COGS','DeferExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_entity IS NULL OR sub.name = :selected_entity)
      GROUP BY category
      ORDER BY amount DESC

pages:
  # ── TAB 1: Monthly Dashboard ──
  - name: Monthly Dashboard
    charts:
      - type: kpi
        title: Total Revenue
        data: kpis
        value: revenue
        format: currency
        prefix: "$"
        label: Year to Date
        width: kpi
      - type: kpi
        title: Total Expense
        data: kpis
        value: expense
        format: currency
        prefix: "$"
        label: Year to Date
        width: kpi
      - type: kpi
        title: EBITDA
        data: kpis
        value: ebitda
        format: currency
        prefix: "$"
        label: Revenue - Expense
        width: kpi
      - type: kpi
        title: Expense Ratio
        data: kpis
        value: expense_ratio
        format: percent
        suffix: "%"
        label: Expense / Revenue
        width: kpi
      - type: line
        title: Monthly Revenue vs Expense
        data: monthly_trend
        x: month
        y: [revenue, expense]
        colors: ["#059669", "#dc2626"]
        width: full
        height: 400
      - type: table
        title: P&L Summary
        data: pl_summary
        width: full
        height: 300
        columns:
          amount: { format: currency, prefix: "$" }

  # ── TAB 2: Revenue Analysis ──
  - name: Revenue Analysis
    charts:
      - type: kpi
        title: Total Revenue
        data: kpis
        value: revenue
        format: currency
        prefix: "$"
        label: Year to Date
        width: kpi
      - type: bar
        title: Revenue by Entity
        data: rev_by_entity
        x: entity
        y: revenue
        colors: ["#1e3a8a"]
        width: full
        height: 480
        cross_filter: entity

  # ── TAB 3: Expense Analysis ──
  - name: Expense Analysis
    charts:
      - type: kpi
        title: Total Expense
        data: kpis
        value: expense
        format: currency
        prefix: "$"
        label: Year to Date
        width: kpi
      - type: kpi
        title: Expense Ratio
        data: kpis
        value: expense_ratio
        format: percent
        suffix: "%"
        width: kpi
      - type: bar
        title: Expense by Type
        data: expense_by_type
        x: expense_type
        y: expense
        colors: ["#dc2626"]
        width: full
        height: 420

  # ── TAB 4: EBITDA Bridge ──
  - name: EBITDA Bridge
    charts:
      - type: kpi
        title: EBITDA
        data: kpis
        value: ebitda
        format: currency
        prefix: "$"
        label: Revenue - Expense
        width: kpi
      - type: bridge
        title: EBITDA Waterfall
        data: ebitda_bridge
        x: category
        y: amount
        width: full
        height: 480
      - type: table
        title: Bridge Detail
        data: ebitda_bridge
        width: full
        height: 250
        columns:
          amount: { format: currency, prefix: "$" }

  # ── TAB 5: Site Performance ──
  - name: Site Performance
    charts:
      - type: bar
        title: Revenue by Entity
        data: rev_by_entity
        x: entity
        y: revenue
        colors: ["#1e3a8a"]
        width: full
        height: 480
        cross_filter: entity
      - type: table
        title: P&L Summary
        data: pl_summary
        width: full
        height: 300
        columns:
          amount: { format: currency, prefix: "$" }
