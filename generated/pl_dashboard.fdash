name: P&L Financial Dashboard
description: Profit & Loss analysis with revenue, expense, and EBITDA
sources:
  - netsuite/ecp

theme: financial

brand:
  company_name: Financial Dashboard
  footer_text: Generated by finch-epm

filters:
  - name: year
    label: Year
    query: >
      SELECT DISTINCT SPLIT_PART(trandate, '/', 3) AS year
      FROM Transaction
      WHERE CAST(SPLIT_PART(trandate, '/', 3) AS INTEGER) >= 2020
      ORDER BY year DESC
    parameter: selected_year
    default: "2024"

  - name: subsidiary
    label: Subsidiary
    query: >
      SELECT DISTINCT s.name AS subsidiary
      FROM Subsidiary s
      WHERE s.isinactive = 'F' AND s.name NOT LIKE '%limination%'
      ORDER BY s.name
    parameter: selected_subsidiary

queries:
  - name: kpis
    sql: |
      SELECT
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END)
        - SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS ebitda,
        ROUND(SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END)
        / NULLIF(SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END), 0) * 100, 1) AS expense_ratio
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)

  - name: monthly
    sql: |
      SELECT
        SPLIT_PART(tx.trandate, '/', 3) || '-' || LPAD(SPLIT_PART(tx.trandate, '/', 1), 2, '0') AS month,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
      GROUP BY month
      ORDER BY month

  - name: rev_by_sub
    sql: |
      SELECT
        s.name AS subsidiary,
        SUM(CAST(t.amount AS DOUBLE)) * -1 AS revenue
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN Subsidiary s ON CAST(tl.subsidiary AS INTEGER) = CAST(s.id AS INTEGER)
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
      GROUP BY s.name
      HAVING SUM(CAST(t.amount AS DOUBLE)) * -1 > 0
      ORDER BY revenue DESC

  - name: pl_detail
    sql: |
      SELECT
        CASE
          WHEN a.accttype IN ('Income','OthIncome') THEN 'Revenue'
          WHEN a.accttype = 'COGS' THEN 'Cost of Goods Sold'
          WHEN a.accttype IN ('Expense','OthExpense') THEN 'Operating Expenses'
          WHEN a.accttype = 'DeferExpense' THEN 'Depreciation & Amortization'
          ELSE a.accttype
        END AS category,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1
            ELSE CAST(t.amount AS DOUBLE) END) AS amount
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome','Expense','OthExpense','COGS','DeferExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
      GROUP BY category
      ORDER BY amount DESC

  - name: expense_dept
    sql: |
      SELECT
        COALESCE(d.name, '(No Department)') AS department,
        SUM(CAST(t.amount AS DOUBLE)) AS expense
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN Department d ON CAST(tl.department AS INTEGER) = CAST(d.id AS INTEGER)
      WHERE t.posting = 'T'
        AND a.accttype IN ('Expense','OthExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
      GROUP BY COALESCE(d.name, '(No Department)')
      HAVING SUM(CAST(t.amount AS DOUBLE)) > 10000
      ORDER BY expense DESC
      LIMIT 15

charts:
  - type: kpi
    title: Total Revenue
    data: kpis
    value: revenue
    format: currency
    prefix: "$"
    label: Year to Date
    width: kpi

  - type: kpi
    title: Total Expense
    data: kpis
    value: expense
    format: currency
    prefix: "$"
    label: Year to Date
    width: kpi

  - type: kpi
    title: EBITDA
    data: kpis
    value: ebitda
    format: currency
    prefix: "$"
    label: Revenue - Expense
    width: kpi

  - type: kpi
    title: Expense Ratio
    data: kpis
    value: expense_ratio
    format: percent
    suffix: "%"
    label: Expense / Revenue
    width: kpi

  - type: line
    title: Monthly Revenue vs Expense
    data: monthly
    x: month
    y: [revenue, expense]
    colors: ["#059669", "#dc2626"]
    width: full
    height: 400

  - type: bar
    title: Revenue by Subsidiary
    data: rev_by_sub
    x: subsidiary
    y: revenue
    colors: ["#1e3a8a"]
    width: half
    height: 420
    cross_filter: subsidiary

  - type: bar
    title: Expense by Department
    data: expense_dept
    x: department
    y: expense
    colors: ["#dc2626"]
    width: half
    height: 420

  - type: table
    title: P&L Summary
    data: pl_detail
    width: full
    height: 300
    columns:
      amount: { format: currency, prefix: "$" }
