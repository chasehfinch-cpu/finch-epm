name: P&L Financial Dashboard
description: Profit & Loss by location, department, and entity — driven by IFS reference tables
sources:
  - netsuite/ecp
  - sqlserver/financedw

theme: financial

brand:
  company_name: Financial Dashboard
  footer_text: Generated by finch-epm

filters:
  - name: year
    label: Year
    query: >
      SELECT DISTINCT SPLIT_PART(tx.trandate, '/', 3) AS year
      FROM Transaction tx
      WHERE CAST(SPLIT_PART(tx.trandate, '/', 3) AS INTEGER) >= 2022
      ORDER BY year DESC
    parameter: selected_year
    default: "2025"

  - name: status
    label: Status
    query: >
      SELECT 'Active' AS status UNION ALL
      SELECT 'Terminated' UNION ALL
      SELECT 'Unused'
    parameter: selected_status

  - name: core_year
    label: Core Year
    query: >
      SELECT 'Core FY26' AS core_year UNION ALL
      SELECT 'Core FY25' UNION ALL
      SELECT 'Core FY24' UNION ALL
      SELECT 'Core FY23'
    parameter: selected_core_year

  - name: group_rollup
    label: Group
    query: >
      SELECT DISTINCT GroupRollup AS group_rollup
      FROM ss__dbo__IFSLocations
      ORDER BY GroupRollup
    parameter: selected_group

  - name: location
    label: Location
    query: >
      SELECT DISTINCT LocationName AS location
      FROM ss__dbo__IFSLocations
      ORDER BY LocationName
    parameter: selected_location

  - name: department
    label: Department
    query: >
      SELECT DISTINCT DepartmentRollup AS department
      FROM ss__dbo__IFSDepartments
      WHERE DepartmentRollup IS NOT NULL AND DepartmentRollup != ''
      ORDER BY DepartmentRollup
    parameter: selected_department

  - name: entity
    label: Entity
    query: >
      SELECT DISTINCT EntityName AS entity
      FROM ss__dbo__IFSEntities
      ORDER BY EntityName
    parameter: selected_entity

queries:
  # === KPI totals ===
  - name: kpis
    sql: |
      SELECT
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END)
        - SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS ebitda,
        ROUND(SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END)
        / NULLIF(SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END), 0) * 100, 1) AS expense_ratio
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      LEFT JOIN ss__dbo__IFSDepartments dept
        ON 'D' || CAST(tl.department AS VARCHAR) = dept.DepartmentID
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_location IS NULL OR loc.LocationName = :selected_location)
        AND (:selected_department IS NULL OR dept.DepartmentRollup = :selected_department)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))

  # === Monthly trend ===
  - name: monthly
    sql: |
      SELECT
        SPLIT_PART(tx.trandate, '/', 3) || '-' || LPAD(SPLIT_PART(tx.trandate, '/', 1), 2, '0') AS month,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1 ELSE 0 END) AS revenue,
        SUM(CASE WHEN a.accttype IN ('Expense','OthExpense','COGS','DeferExpense')
            THEN CAST(t.amount AS DOUBLE) ELSE 0 END) AS expense
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      LEFT JOIN ss__dbo__IFSDepartments dept
        ON 'D' || CAST(tl.department AS VARCHAR) = dept.DepartmentID
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      WHERE t.posting = 'T'
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_location IS NULL OR loc.LocationName = :selected_location)
        AND (:selected_department IS NULL OR dept.DepartmentRollup = :selected_department)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))
      GROUP BY month
      ORDER BY month

  # === Revenue by Group (IFS GroupRollup) ===
  - name: rev_by_group
    sql: |
      SELECT
        COALESCE(loc.GroupRollup, '(Unmapped)') AS group_name,
        SUM(CAST(t.amount AS DOUBLE)) * -1 AS revenue
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_location IS NULL OR loc.LocationName = :selected_location)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))
      GROUP BY group_name
      HAVING SUM(CAST(t.amount AS DOUBLE)) * -1 > 0
      ORDER BY revenue DESC

  # === Expense by Department Rollup ===
  - name: expense_by_dept
    sql: |
      SELECT
        COALESCE(dept.DepartmentRollup, '(Unmapped)') AS department,
        SUM(CAST(t.amount AS DOUBLE)) AS expense
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSDepartments dept
        ON 'D' || CAST(tl.department AS VARCHAR) = dept.DepartmentID
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      WHERE t.posting = 'T'
        AND a.accttype IN ('Expense','OthExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_location IS NULL OR loc.LocationName = :selected_location)
        AND (:selected_department IS NULL OR dept.DepartmentRollup = :selected_department)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))
      GROUP BY department
      HAVING SUM(CAST(t.amount AS DOUBLE)) > 10000
      ORDER BY expense DESC
      LIMIT 15

  # === P&L by account type ===
  - name: pl_summary
    sql: |
      SELECT
        CASE
          WHEN a.accttype IN ('Income','OthIncome') THEN 'Revenue'
          WHEN a.accttype = 'COGS' THEN 'Cost of Goods Sold'
          WHEN a.accttype IN ('Expense','OthExpense') THEN 'Operating Expenses'
          WHEN a.accttype = 'DeferExpense' THEN 'Depreciation & Amortization'
          ELSE a.accttype
        END AS category,
        SUM(CASE WHEN a.accttype IN ('Income','OthIncome')
            THEN CAST(t.amount AS DOUBLE) * -1
            ELSE CAST(t.amount AS DOUBLE) END) AS amount
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      LEFT JOIN ss__dbo__IFSDepartments dept
        ON 'D' || CAST(tl.department AS VARCHAR) = dept.DepartmentID
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome','Expense','OthExpense','COGS','DeferExpense')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_location IS NULL OR loc.LocationName = :selected_location)
        AND (:selected_department IS NULL OR dept.DepartmentRollup = :selected_department)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))
      GROUP BY category
      ORDER BY amount DESC

  # === Revenue by Entity ===
  - name: rev_by_entity
    sql: |
      SELECT
        COALESCE(ent.EntityName, '(Unmapped)') AS entity,
        SUM(CAST(t.amount AS DOUBLE)) * -1 AS revenue
      FROM TransactionAccountingLine t
      JOIN Account a ON CAST(t.account AS INTEGER) = CAST(a.id AS INTEGER)
      JOIN Transaction tx ON CAST(t.transaction AS INTEGER) = CAST(tx.id AS INTEGER)
      JOIN TransactionLine tl
        ON CAST(t.transaction AS INTEGER) = CAST(tl.transaction AS INTEGER)
        AND CAST(t.transactionline AS INTEGER) = CAST(tl.id AS INTEGER)
      LEFT JOIN ss__dbo__IFSEntities ent
        ON 'E' || CAST(tl.subsidiary AS VARCHAR) = ent.EntityID
      LEFT JOIN ss__dbo__IFSLocations loc
        ON 'L' || CAST(tl.location AS VARCHAR) = loc.LocationID
      WHERE t.posting = 'T'
        AND a.accttype IN ('Income','OthIncome')
        AND (:selected_year IS NULL OR SPLIT_PART(tx.trandate, '/', 3) = :selected_year)
        AND (:selected_group IS NULL OR loc.GroupRollup = :selected_group)
        AND (:selected_entity IS NULL OR ent.EntityName = :selected_entity)
        AND (:selected_status IS NULL
             OR (:selected_status = 'Active' AND loc.ActiveBusiness = 1)
             OR (:selected_status = 'Terminated' AND loc.TerminatedBusiness = 1)
             OR (:selected_status = 'Unused' AND loc.Unused = 1))
        AND (:selected_core_year IS NULL
             OR (:selected_core_year = 'Core FY26' AND loc.CoreFY26 = 1)
             OR (:selected_core_year = 'Core FY25' AND loc.CoreFY25 = 1)
             OR (:selected_core_year = 'Core FY24' AND loc.CoreFY24 = 1)
             OR (:selected_core_year = 'Core FY23' AND loc.CoreFY23 = 1))
      GROUP BY entity
      HAVING SUM(CAST(t.amount AS DOUBLE)) * -1 > 0
      ORDER BY revenue DESC

charts:
  # KPI row
  - type: kpi
    title: Total Revenue
    data: kpis
    value: revenue
    format: currency
    prefix: "$"
    label: Year to Date
    width: kpi

  - type: kpi
    title: Total Expense
    data: kpis
    value: expense
    format: currency
    prefix: "$"
    label: Year to Date
    width: kpi

  - type: kpi
    title: EBITDA
    data: kpis
    value: ebitda
    format: currency
    prefix: "$"
    label: Revenue - Expense
    width: kpi

  - type: kpi
    title: Expense Ratio
    data: kpis
    value: expense_ratio
    format: percent
    suffix: "%"
    label: Expense / Revenue
    width: kpi

  # Monthly trend
  - type: line
    title: Monthly Revenue vs Expense
    data: monthly
    x: month
    y: [revenue, expense]
    colors: ["#059669", "#dc2626"]
    width: full
    height: 400

  # Revenue breakdowns
  - type: bar
    title: Revenue by Group
    data: rev_by_group
    x: group_name
    y: revenue
    colors: ["#1e3a8a"]
    width: half
    height: 420
    cross_filter: group_name

  - type: bar
    title: Revenue by Entity
    data: rev_by_entity
    x: entity
    y: revenue
    colors: ["#2563eb"]
    width: half
    height: 420
    cross_filter: entity

  # Expense breakdown
  - type: bar
    title: Expense by Department
    data: expense_by_dept
    x: department
    y: expense
    colors: ["#dc2626"]
    width: half
    height: 420

  # P&L summary table
  - type: table
    title: P&L Summary
    data: pl_summary
    width: half
    height: 300
    columns:
      amount: { format: currency, prefix: "$" }
